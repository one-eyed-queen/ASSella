[Desktop Entry]
Type=Application
Name=EXE-fingerprinter
Comment=Steam Game & Depot Management Suite
# Named exe_fingerprinter.desktop to match setDesktopFileName() in src/main.py.
Exec=/usr/bin/exe_fingerprinter %U
Icon=exe_fingerprinter
Terminal=false
Categories=Utility;Game;
# Must match QApplication::applicationName() in src/main.py for correct
# window/icon association under Wayland compositors.
StartupWMClass=EXE-fingerprinter